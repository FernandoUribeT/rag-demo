# PLANTILLA. Copiar a .env y rellenar ahi.
# Este archivo SI se sube al repositorio: nunca pongas valores reales aqui.

# ── Stripe (modo prueba) ─────────────────────────────────────────────────────
# Panel de Stripe > Developers > API keys, con Test mode activado.
STRIPE_SECRET_KEY=PON_AQUI_TU_CLAVE

# Lo imprime `stripe listen` al arrancar. Cambia en cada reinicio.
STRIPE_WEBHOOK_SECRET=PON_AQUI_TU_SECRETO

# ── Resto ────────────────────────────────────────────────────────────────────
URL_EXITO=http://localhost:4200/pago/exito
URL_CANCELADO=http://localhost:4200/pago/cancelado
ORIGENES_PERMITIDOS=http://localhost:4200

# Modelos de Ollama. Ajustar a lo que este instalado (ollama list).
OLLAMA_URL=http://127.0.0.1:11434
MODELO_EMBEDDING=bge-m3
MODELO_LENGUAJE=qwen3:8b
