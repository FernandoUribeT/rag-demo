# Copiar a .env y rellenar. NUNCA commitear el .env real.
#
# Claves de PRUEBA de Stripe: empiezan con sk_test_ y no mueven dinero real.
# Se sacan del panel de Stripe en Developers > API keys, con el modo de prueba
# activado.
STRIPE_SECRET_KEY=sk_test_...

# Lo imprime `stripe listen` al arrancar. Cambia cada vez que se reinicia el
# comando, así que hay que copiarlo de nuevo en cada sesión.
STRIPE_WEBHOOK_SECRET=whsec_...

URL_EXITO=http://localhost:4200/pago/exito
URL_CANCELADO=http://localhost:4200/pago/cancelado
ORIGENES_PERMITIDOS=http://localhost:4200
